{
  "name": "quill-image-alt",
  "version": "0.1.6",
  "description": "A lightweight Quill module for adding and editing image alt text, with a hover badge and inline editor",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "unpkg": "dist/index.iife.js",
  "jsdelivr": "dist/index.iife.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "quill",
    "quilljs",
    "quill-module",
    "quill-image-alt",
    "editor",
    "image",
    "alt",
    "alt-text",
    "accessibility",
    "a11y",
    "react",
    "javascript",
    "front-end"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlenines/quill-image-alt.git"
  },
  "homepage": "https://github.com/littlenines/quill-image-alt#readme",
  "bugs": {
    "url": "https://github.com/littlenines/quill-image-alt/issues"
  },
  "author": "littlenines",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "quill": ">=1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "quill": "^2.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
