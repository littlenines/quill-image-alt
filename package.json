{
  "name": "quill-image-alt",
  "version": "0.1.0",
  "description": "A lightweight Quill module for adding and editing image alt text, with a hover badge and inline editor",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "unpkg": "dist/index.iife.js",
  "jsdelivr": "dist/index.iife.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "images",
    "README.md"
  ],
  "keywords": [
    "quill",
    "quilljs",
    "quill-module",
    "editor",
    "image",
    "alt",
    "quill-alt-text",
    "quill-text-alt",
    "quill-alt",
    "alt-text",
    "accessibility",
    "a11y",
    "react",
    "javascript",
    "front-end"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "quill": "^2.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
